# Access key ID for DynamoDB when running locally. Used for authentication in local environments, which you can find in NoSQL Workbench.
APP_AWS_DYNAMODB_ACCESS_KEY_ID=ln7mv

# Secret access key for DynamoDB when running locally. Paired with the access key ID for local authentication, which you can find in NoSQL Workbench.
APP_AWS_DYNAMODB_SECRET_ACCESS_KEY=2h9fp

# The AWS region set for local DynamoDB instance. Typically set to "local" when working with DynamoDB locally.
APP_AWS_DYNAMODB_REGION=local

# AWS DynamoDB endpoint set for local DynamoDB instance.
APP_AWS_DYNAMODB_ENDPOINT=http://localhost:8000

# AWS DynamoDB table name set for local DynamoDB instance.
APP_AWS_DYNAMODB_TABLE_NAME=worko-chat

# AWS region set for local API Gateway instance. 
WSSAPIGATEWAYENDPOINT=ws://localhost:3001

# AWS region set for local API Gateway instance.
APP_SLS_REGION=ap-south-1

# AWS account ID set for API Gateway instance.
APP_AWS_ACCOUNT_ID=211125353899

# APP logger in json format
APP_LOGGER_LOG_FORMAT="json"