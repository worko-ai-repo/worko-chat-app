# The AWS region where the Serverless service and its resources (e.g., DynamoDB, Lambda) are deployed.
APP_SLS_REGION=ap-south-1

# The WebSocket API Gateway endpoint URL for the Worko Chat application in Production environment.
WSSAPIGATEWAYENDPOINT=https://chatws.worko.ai

# The name of the DynamoDB table used by the application to store chat data.
APP_AWS_DYNAMODB_TABLE_NAME=worko-chat

# The AWS Account ID where the Worko application and its services (Lambda, DynamoDB, API Gateway) are hosted.
APP_AWS_ACCOUNT_ID=211125595046

# APP logger in json format
APP_LOGGER_LOG_FORMAT="json"